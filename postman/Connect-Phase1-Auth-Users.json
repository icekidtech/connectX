  "item": [
    {
      "name": "Auth - Registration & Login",
      "item": [
        {
          "name": "1. Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', jsonData.token);",
                  "    pm.environment.set('user_id', jsonData.id);",
                  "    pm.environment.set('user_email', jsonData.email);",
                  "    pm.environment.set('user_username', jsonData.username);",
                  "    pm.test('✓ User registered successfully', function () { pm.expect(jsonData.token).to.exist; });",
                  "} else {",
                  "    pm.test('✗ Registration failed', function () { pm.expect(pm.response.code).to.equal(201); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"username\": \"testuser_{{$timestamp}}\",\n  \"password\": \"SecurePass123!\",\n  \"confirmPassword\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/auth/signup",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          }
