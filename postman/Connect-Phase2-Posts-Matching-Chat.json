{
  "info": {
    "name": "ConnectX Phase 2: Posts, Matching & Chat",
    "description": "Complete Phase 2 API testing collection with Posts & Social Feed, Matching & Recommendations, and Chat REST endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts - Creation & Management",
      "item": [
        {
          "name": "Create Post with Caption",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caption\": \"Beautiful sunset at the beach! 🌅\",\n  \"hashtags\": [\"travel\", \"sunset\", \"beach\"],\n  \"isNsfw\": false,\n  \"visibility\": \"public\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/posts",
              "host": ["{{api_url}}"],
              "path": ["posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('post_id', jsonData.id);",
                  "  pm.test('✓ Post created successfully', function() {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "    pm.expect(jsonData.id).to.exist;",
                  "  });",
                  "} else {",
                  "  pm.test('✗ Failed to create post', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Posts Feed (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/posts/feed?page=1&limit=10",
              "host": ["{{api_url}}"],
              "path": ["posts", "feed"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✓ Feed retrieved successfully', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Single Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/posts/{{post_id}}",
              "host": ["{{api_url}}"],
              "path": ["posts", "{{post_id}}"]
            }
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caption\": \"Updated: Amazing sunset, can't stop thinking about it!\",\n  \"hashtags\": [\"travel\", \"sunset\", \"beach\", \"wanderlust\"],\n  \"visibility\": \"friends\"\n}"
            },
            "url": {
              "raw": "{{api_url}}/posts/{{post_id}}",
              "host": ["{{api_url}}"],
              "path": ["posts", "{{post_id}}"]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/posts/{{post_id}}",
              "host": ["{{api_url}}"],
              "path": ["posts", "{{post_id}}"]
            }
          }
        }
      ]
    },
