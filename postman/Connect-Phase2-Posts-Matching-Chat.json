              }
            ],
            "url": {
              "raw": "{{api_url}}/posts/comment/{{comment_id}}/like",
              "host": ["{{api_url}}"],
              "path": ["posts", "comment", "{{comment_id}}", "like"]
            }
          }
        },
        {
          "name": "Get Comment Likes",
          "request": {
            "method": "GET",
            "header": [
              {
