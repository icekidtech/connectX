    {
      "name": "Media Upload",
      "item": [
        {
          "name": "Upload Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{api_url}}/upload/image",
              "host": ["{{api_url}}"],
              "path": ["upload", "image"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('media_url', jsonData.url);",
                  "  pm.environment.set('media_public_id', jsonData.publicId);",
                  "  pm.test('✓ Image uploaded successfully', function() {",
                  "    pm.expect(jsonData.url).to.exist;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
