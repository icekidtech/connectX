    {
      "name": "Matching - Recommendations & Likes",
      "item": [
        {
          "name": "Get Recommendations (with Filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/recommendations?page=1&limit=10&ageMin=20&ageMax=40&maxDistance=50&genderFilter=female",
              "host": ["{{api_url}}"],
              "path": ["matching", "recommendations"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "ageMin",
                  "value": "20"
                },
                {
                  "key": "ageMax",
                  "value": "40"
                },
                {
                  "key": "maxDistance",
                  "value": "50"
                },
                {
                  "key": "genderFilter",
                  "value": "female"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✓ Recommendations retrieved', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.be.an('array');",
                  "  if (jsonData.length > 0) {",
                  "    pm.environment.set('matched_user_id', jsonData[0].id);",
                  "    pm.expect(jsonData[0].compatibilityScore).to.exist;",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Like User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/{{matched_user_id}}/like",
              "host": ["{{api_url}}"],
              "path": ["matching", "{{matched_user_id}}", "like"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✓ User liked', function() {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.status === 'matched') {",
                  "    pm.test('  → Mutual match created!');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unlike User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/{{matched_user_id}}/like",
              "host": ["{{api_url}}"],
              "path": ["matching", "{{matched_user_id}}", "like"]
            }
          }
        },
        {
          "name": "Get My Matches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/matches?page=1&limit=10",
              "host": ["{{api_url}}"],
              "path": ["matching", "matches"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✓ Matches retrieved', function() {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/{{matched_user_id}}/block",
              "host": ["{{api_url}}"],
              "path": ["matching", "{{matched_user_id}}", "block"]
            }
          }
        },
        {
          "name": "Unblock User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{api_url}}/matching/{{matched_user_id}}/block",
              "host": ["{{api_url}}"],
              "path": ["matching", "{{matched_user_id}}", "block"]
            }
          }
        }
      ]
